# Application settings
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
DATABASE_URL=sqlite:///./data/app.db
ENVIRONMENT=development

# Default timezone for display (IANA format)
DEFAULT_TIMEZONE=America/New_York

# Default billing currency (ISO 4217)
DEFAULT_CURRENCY=USD

# AI Provider API Keys (server-side only, never logged)
# Leave blank if not using that provider's API integration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=

# Session settings
ACCESS_TOKEN_EXPIRE_MINUTES=480
